# Bu dosyayı ".env" adıyla kopyalayıp değerleri düzenleyin:
#   copy .env.example .env

POSTGRES_USER=pulsecraft
POSTGRES_PASSWORD=degistir_beni
POSTGRES_DB=pulsecraft

DB_PORT=5432
REDIS_PORT=6379
SERVER_PORT=8080

# ---------------------------------------------------------------------
# Kimlik doğrulama (Evre 4.0)
# ---------------------------------------------------------------------

# Oturum (JWT) imzalama anahtarı. ZORUNLU ve EN AZ 32 KARAKTER: boş veya kısaysa
# server başlamaz. Bilerek boş bırakıldı — repoda herkesin bildiği bir sır olmasın.
# PowerShell'de güvenli rastgele değer üretmek için:
#   $b = [byte[]]::new(48); [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Demo kullanıcılar: e-posta:parola:görünen ad
# Birden çok kullanıcı ';' ile ayrılır. Server her açılışta bu listeyi DB'ye
# yazar (aynı e-posta varsa parola ve ad güncellenir); listede olmayan
# kullanıcılara dokunulmaz.
# KISITLAR (her kayıt İLK İKİ ':' karakterinden bölünür):
#   - e-posta ve parola ':' veya ';' İÇEREMEZ (paroladaki ':' sessizce yanlış bölünür)
#   - görünen ad ';' içeremez ama ':' içerebilir
#   - parola 8-72 bayt olmalı; '$', '#' ve tırnak KULLANMAYIN (docker compose .env
#     dosyasında değişken/yorum/tırnak olarak yorumlanır)
DEMO_USERS=admin@pulsecraft.local:degistir_beni_123:Admin;ops@pulsecraft.local:degistir_beni_456:Operatör
