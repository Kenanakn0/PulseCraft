# Copy this file to ".env" and fill in the values:
#   copy .env.example .env        (macOS / Linux: cp .env.example .env)

POSTGRES_USER=pulsecraft
# REQUIRED: compose refuses to start without it. Use a strong random value (e.g. one generated with the
# JWT_SECRET command below). Characters like '@ : / ?' would need percent-encoding in DATABASE_URL;
# letters and digits only is easiest.
POSTGRES_PASSWORD=
POSTGRES_DB=pulsecraft

# Ports published on the host (all bound to 127.0.0.1 only). Browsers and agents use nginx:
# http://localhost:WEB_PORT. The server's own port is not published.
WEB_PORT=8080
DB_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------

# Session (JWT) signing key. REQUIRED, AT LEAST 32 CHARACTERS: the server refuses to start otherwise.
# Deliberately empty, so that no publicly known secret exists. To generate one in PowerShell:
#   $b = [byte[]]::new(48); [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Demo users: email:password:Display name, several separated by ';'. On every start the server writes
# this list to the database (an existing e-mail gets its password and name updated); users not listed are
# left alone.
# RULES (each entry is split at its FIRST TWO ':' characters):
#   - e-mail and password must not contain ':' or ';' (a ':' in the password would split it silently)
#   - the display name must not contain ';' but may contain ':'
#   - passwords are 8-72 bytes; do NOT use '$', '#' or quotes (docker compose interprets them in .env)
#   - REQUIRED: compose refuses to start without it. The server refuses placeholder passwords (containing
#     "degistir" or "changeme"), very common ones (password123, demo1234 ...), a password equal to the
#     e-mail address, and a single repeated character.
# Format (choose your own passwords):
#   DEMO_USERS=admin@pulsecraft.local:<password>:Admin;ops@pulsecraft.local:<password>:Operatör
DEMO_USERS=

# Adds the Secure flag to the session cookie (sent over HTTPS only). false for local HTTP development,
# true behind HTTPS.
COOKIE_SECURE=false

# TRUSTED_PROXIES: with docker compose this is pinned in docker-compose.yml to nginx's fixed address
# (172.30.10.10); setting it here has no effect. Only when running the server outside compose (e.g.
# `go run`) pass it as an environment variable: a comma-separated CIDR list. X-Forwarded-For is read only
# if the direct peer is one of these addresses, otherwise the connection address is used (anyone can forge
# the header). Empty trusts no proxy. Wide ranges (such as 172.16.0.0/12) may include the gateway (host).
