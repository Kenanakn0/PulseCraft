# --- Secrets ---
.env
*.env
!.env.example

# --- Go ---
/agent/bin/
/server/bin/
*.exe
*.test
*.out
coverage.*

# --- Node / frontend ---
node_modules/
dist/
build/
# Playwright output (local screenshots and traces; README images live in docs/)
/web/test-results/
/web/playwright-report/
/web/e2e/screenshots/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# --- Session cookie / token files ---
cookie.txt
*.cookie

# --- Playwright session state (contains session cookies) ---
/web/e2e/.auth/

# --- Agent API key files (-api-key-file) ---
*.key

# --- deploy/secrets: secrets such as the demo agent key (only the README is tracked) ---
/deploy/secrets/*
!/deploy/secrets/README.md
