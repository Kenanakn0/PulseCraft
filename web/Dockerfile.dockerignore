# .dockerignore for web/Dockerfile (context = repository root). Allow-list: exclude EVERYTHING, then add back
# what is needed, so server/, agent/, .git and deploy/.env (secrets) never enter the build context.
*
!web
!deploy/nginx/conf.d

# Parts of web/ that the build does not need
web/node_modules
web/dist
web/test-results
web/playwright-report
web/e2e
web/smoke
web/Dockerfile
web/Dockerfile.dockerignore
